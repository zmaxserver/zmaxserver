{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ZMaxVHostConfig",
  "type": "object",
  "oneOf": [
    {
      "type": "object",
      "required": ["domain", "root"],
      "properties": {
        "domain": {
          "type": "string",
          "description": "Birincil alan adı (örn: example.com)"
        },
        "aliases": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Ek alan adları ve alt alan adları"
        },
        "root": {
          "type": "string",
          "description": "Web kök dizini mutlak yolu"
        },
        "php_upstream": {
          "type": "string",
          "description": "FastCGI unix soketi veya TCP adresi"
        },
        "force_https": {
          "type": "boolean",
          "default": false
        },
        "tls_cert": {
          "type": "string",
          "description": "TLS sertifika dosyası yolu"
        },
        "tls_key": {
          "type": "string",
          "description": "TLS özel anahtar dosyası yolu"
        },
        "h2_enabled": {
          "type": "boolean",
          "default": true
        },
        "cache_enabled": {
          "type": "boolean",
          "default": false
        },
        "cache_ttl_sec": {
          "type": "integer",
          "default": 3600
        },
        "security_profile": {
          "type": "string",
          "enum": ["default", "strict", "relaxed", "custom"],
          "default": "default"
        },
        "waf_mode": {
          "type": "string",
          "enum": ["disabled", "detect", "block"],
          "default": "detect"
        },
        "custom_headers": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      },
      "additionalProperties": true
    },
    {
      "type": "object",
      "required": ["name", "document_root"],
      "properties": {
        "name": {
          "type": "string",
          "description": "vHost alan adı (vhost.name)"
        },
        "aliases": {
          "type": "array",
          "items": { "type": "string" }
        },
        "document_root": {
          "type": "string",
          "description": "Web kök dizini (vhost.document_root)"
        },
        "cache": {
          "type": "object"
        },
        "php": {
          "type": "object"
        },
        "ssl": {
          "type": "object"
        },
        "security": {
          "type": "object"
        },
        "rewrite": {
          "type": "object"
        },
        "proxy": {
          "type": "object"
        },
        "headers": {
          "type": "object"
        }
      },
      "additionalProperties": true
    },
    {
      "type": "object",
      "required": ["vhost"],
      "properties": {
        "vhost": {
          "type": "object",
          "required": ["name", "document_root"],
          "properties": {
            "name": { "type": "string" },
            "document_root": { "type": "string" }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    }
  ]
}

