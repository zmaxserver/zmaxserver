Date: Sat, 14 Nov 2026 10:23:32 +0300
Subject: [PATCH 5/8] [vm-yukle] WebAdmin: Yenile/Tumunu bosalt calisir, tekrar
 eden Yonetici dugmesi kaldirildi, yoklama 5 sn; API hiz siniri 120->600/dk

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 admin/index.html              | 10 ++--------
 admin/js/app.js               | 21 ++++++++++++++++++++-
 admin/js/i18n.js              |  5 +++++
 crates/zmax-config/src/lib.rs |  5 +++--
 4 files changed, 30 insertions(+), 11 deletions(-)

diff --git a/admin/index.html b/admin/index.html
index 021f706..32528de 100644
--- a/admin/index.html
+++ b/admin/index.html
@@ -159,12 +159,6 @@
                         <span class="status-dot" :class="hasActiveToken ? 'status-dot-active' : 'status-dot-warning'"></span>
                     </button>
 
-                    <div class="user-pill d-none d-sm-flex" role="button" @click="openAuthModal" style="cursor: pointer;" :title="t('auth_modal_title')">
-                        <svg class="icon text-orange" viewBox="0 0 24 24" fill="none" stroke="currentColor">
-                            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle>
-                        </svg>
-                        <span>{{ t('admin_user') }}</span>
-                    </div>
                 </div>
             </header>
 
@@ -184,8 +178,8 @@
                         :hit-rate="hitRate"
                         :formatted-uptime="formattedUptime"
                         :t="t"
-                        @fetch-status="fetchStatus"
-                        @purge-all-cache="fetchStatus"
+                        @fetch-status="refreshNow"
+                        @purge-all-cache="purgeAllCache"
                     ></view-dashboard>
 
                     <!-- U5: SANAL KONAKLAR (VHOSTS) -->
diff --git a/admin/js/app.js b/admin/js/app.js
index 91d167a..040e01d 100644
--- a/admin/js/app.js
+++ b/admin/js/app.js
@@ -334,6 +334,23 @@
                 } catch (_) {}
             };
 
+            // Yenile düğmesi: durumu çeker ve görünür geri bildirim verir.
+            const refreshNow = async () => {
+                await fetchStatus();
+                showNotice(t('notice_refreshed'));
+            };
+
+            // Tümünü boşalt: gerçekten /api/v1/cache/purge çağrılır, sonra durum yenilenir.
+            const purgeAllCache = async () => {
+                try {
+                    const res = await window.ZMaxApiClient.purgeAll();
+                    showNotice(res && res.ok ? t('notice_purged_all') : t('notice_purge_error'));
+                } catch (e) {
+                    showNotice(t('notice_purge_error'));
+                }
+                await fetchStatus();
+            };
+
             const fetchStatus = async () => {
                 try {
                     const [statusData, vhData, modData, banData, logData] = await Promise.all([
@@ -446,7 +463,7 @@
                 syncDocumentTitleAndLang(currentLang.value);
                 document.documentElement.setAttribute('data-theme', theme.value);
                 fetchStatus();
-                pollTimer = setInterval(fetchStatus, 2000);
+                pollTimer = setInterval(fetchStatus, 5000);
             });
 
             onUnmounted(() => {
@@ -492,6 +509,8 @@
                 loginWithToken,
                 logoutToken,
                 fetchStatus,
+                purgeAllCache,
+                refreshNow,
                 fetchLogs,
                 onVhostDeleted,
                 onUnbanIp
