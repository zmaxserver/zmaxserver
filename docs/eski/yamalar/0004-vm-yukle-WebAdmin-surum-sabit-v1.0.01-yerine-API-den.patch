From d9f3a8eebbd6a1613734dbb1922a2ec8b783bb70 Mon Sep 17 00:00:00 2001
From: webtasarimofisim <webtasarimofisim@users.noreply.github.com>
Date: Sat, 14 Nov 2026 10:20:39 +0300
Subject: [PATCH 4/8] [vm-yukle] WebAdmin: surum sabit v1.0.01 yerine API'den;
 karsilama kartindan surum kaldirildi

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 admin/index.html            | 2 +-
 admin/js/app.js             | 2 ++
 admin/js/views/dashboard.js | 4 ++--
 3 files changed, 5 insertions(+), 3 deletions(-)

diff --git a/admin/index.html b/admin/index.html
index 7f730bc..021f706 100644
--- a/admin/index.html
+++ b/admin/index.html
@@ -345,7 +345,7 @@
             <!-- Sabit Alt Bilgi (Fixed Footer) -->
             <footer class="app-footer">
                 <div class="footer-left">
-                    <span>&copy; 2026 {{ t('footer_copyright') }} &middot; <strong class="text-orange">ZMax Server v1.0.01</strong> <span class="d-none d-md-inline">({{ t('footer_enterprise') }})</span></span>
+                    <span>&copy; 2026 {{ t('footer_copyright') }} &middot; <strong class="text-orange">ZMax Server v{{ stats.version || '…' }}</strong> <span class="d-none d-md-inline">({{ t('footer_enterprise') }})</span></span>
                 </div>
                 <div class="footer-right">
                     <span class="footer-badge d-none d-lg-inline-flex">{{ t('footer_engine') }}</span>
diff --git a/admin/js/app.js b/admin/js/app.js
index 94cac4e..91d167a 100644
--- a/admin/js/app.js
+++ b/admin/js/app.js
@@ -176,6 +176,7 @@
                 cache_misses: 0,
                 workers: 0,
                 ram_mb: 0,
+                version: '',
                 cpu_usage: 0,
                 current_rps: 0,
                 ports: {
@@ -350,6 +351,7 @@
                         if (typeof statusData.cache_misses === 'number') stats.value.cache_misses = statusData.cache_misses;
                         if (typeof statusData.workers === 'number') stats.value.workers = statusData.workers;
                         if (typeof statusData.ram_mb === 'number') stats.value.ram_mb = statusData.ram_mb;
+                        if (typeof statusData.version === 'string' && statusData.version) stats.value.version = statusData.version;
                         if (typeof statusData.cpu_usage === 'number') stats.value.cpu_usage = statusData.cpu_usage;
                         if (typeof statusData.current_rps === 'number') stats.value.current_rps = statusData.current_rps;
                         if (statusData.ports) {
diff --git a/admin/js/views/dashboard.js b/admin/js/views/dashboard.js
index f7eb008..e405f89 100644
--- a/admin/js/views/dashboard.js
+++ b/admin/js/views/dashboard.js
@@ -43,7 +43,7 @@
                         <div>
                             <div class="welcome-title">{{ t('welcome_title') }}</div>
                             <div class="welcome-meta">
-                                panel.zmaxserver.local · <strong class="text-orange">ZMax Server v1.0.01</strong> · {{ t('card_uptime') }}: {{ formattedUptime }}
+                                panel.zmaxserver.local · {{ t('card_uptime') }}: {{ formattedUptime }}
                             </div>
                         </div>
                     </div>
@@ -167,7 +167,7 @@
                             <div class="info-kv-list">
                                 <div class="info-kv-row"><span class="text-muted-custom">{{ t('lbl_hostname') }}</span> <strong>zmaxserver.local</strong></div>
                                 <div class="info-kv-row"><span class="text-muted-custom">{{ t('lbl_ip_port') }}</span> <strong>{{ stats.listeners && stats.listeners.http ? stats.listeners.http : '0.0.0.0:19480' }}</strong></div>
-                                <div class="info-kv-row"><span class="text-muted-custom">{{ t('lbl_engine') }}</span> <strong>ZMax Server v1.0.01 ({{ t('footer_engine') }})</strong></div>
+                                <div class="info-kv-row"><span class="text-muted-custom">{{ t('lbl_engine') }}</span> <strong>ZMax Server v{{ stats.version || '…' }} ({{ t('footer_engine') }})</strong></div>
                             </div>
                         </div>
                     </div>
