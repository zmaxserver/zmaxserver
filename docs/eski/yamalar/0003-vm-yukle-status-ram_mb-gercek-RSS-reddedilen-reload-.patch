 crates/zmax-bin/src/api/services/config_service.rs |  5 ++++-
 2 files changed, 15 insertions(+), 2 deletions(-)

diff --git a/crates/zmax-bin/src/api/routes/system.rs b/crates/zmax-bin/src/api/routes/system.rs
index fc5343a..dc2d5bc 100644
--- a/crates/zmax-bin/src/api/routes/system.rs
+++ b/crates/zmax-bin/src/api/routes/system.rs
@@ -108,6 +108,15 @@ where
     Ok(false)
 }
 
+/// Süreç yerleşik bellek kullanımı (MB); Linux dışında veya okunamazsa 0.
+fn rss_mb() -> u64 {
+    std::fs::read_to_string("/proc/self/statm")
+        .ok()
+        .and_then(|t| t.split_whitespace().nth(1).and_then(|v| v.parse::<u64>().ok()))
+        .map(|pages| pages * 4096 / (1024 * 1024))
+        .unwrap_or(0)
+}
+
 pub(super) async fn status<S>(
     socket: &mut S,
     req: &ParsedHttpRequest,
@@ -136,7 +145,7 @@ where
         };
